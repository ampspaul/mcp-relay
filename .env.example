# Secret backend — choose one: env, gcp, aws, azure, vault, plain
export SECRET_BACKEND=env

# Port the server listens on
export PORT=8080

# --- env backend (default) ---
# Set secrets as env vars matching your remote_servers.yaml secret:: references
# export MY_API_KEY=your-key-here

# --- GCP backend ---
# export GCP_PROJECT_ID=your-project-id

# --- AWS backend ---
# export AWS_REGION=us-east-1

# --- Azure backend ---
# export AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net

# --- Vault backend ---
# export VAULT_ADDR=http://127.0.0.1:8200
# export VAULT_TOKEN=your-token

# --- PII scan (optional) ---
# export OLLAMA_URL=http://localhost:11434
