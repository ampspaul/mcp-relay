# Secret backend — choose one: env, gcp, aws, azure, vault, plain
SECRET_BACKEND=env

# Port the server listens on
PORT=8080

# --- env backend (default) ---
# Set secrets as env vars matching your remote_servers.yaml secret:: references
# MY_API_KEY=your-key-here

# --- GCP backend ---
# GCP_PROJECT_ID=your-project-id

# --- AWS backend ---
# AWS_REGION=us-east-1

# --- Azure backend ---
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net

# --- Vault backend ---
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=your-token

# --- PII scan (optional) ---
# OLLAMA_URL=http://localhost:11434
